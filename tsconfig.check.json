{
  // Logic typecheck scoped to committed source + tests only. The base tsconfig's
  // broad "**/*.ts" include also picks up local, gitignored scratch files under
  // scripts/, which reference modules that don't exist in the repo and would
  // otherwise fail `tsc`. Use this config (via `npm run typecheck`) for a clean
  // signal on the code we actually track.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Separate config => separate build info file, so it never clobbers the
    // base config's incremental cache.
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.check.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
