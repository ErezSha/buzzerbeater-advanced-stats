BB_LOGIN=
BB_SECURITY_CODE=
# Optional: set to 1 for a second BuzzerBeater team.
BB_SECOND_TEAM=

# Required in production (e.g. Vercel), where there is no .env.local and
# credentials are entered through the UI. Used to AES-256-GCM encrypt the
# httpOnly credentials cookie. Use a long random string. Optional locally —
# when BB_LOGIN/BB_SECURITY_CODE are set, the cookie path is never used.
CREDENTIALS_SECRET=
